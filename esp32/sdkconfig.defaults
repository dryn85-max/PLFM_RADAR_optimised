# AERIS-10 Lite MVP: ESP32-S3-DevKitC-1 N32R8V (32 MB octal flash, 8 MB octal PSRAM).
# No secrets in this file.
CONFIG_IDF_TARGET="esp32s3"

# 8 MB octal PSRAM (the N32R8V module). VERIFY on the real board.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# 32 MB octal flash. VERIFY on the real board (module marking N32 = 32 MB octal flash).
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# Partition table: ESP-IDF "single factory app (large)": NVS at 0x9000 (same offset and size
# as the plain single-app table, so stored Wi-Fi credentials survive), 1.5 MB factory app.
# The plain table's 1 MB app was 97 % full (owner decision 2026-10-02). app_main.c stops the
# build with #error if a stale esp32/sdkconfig still selects another table.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Console and flashing through the native USB port (USB-Serial-JTAG, GPIO19/20).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 ms scheduler tick.
CONFIG_FREERTOS_HZ=1000

# Main task stack: Wi-Fi start-up runs in app_main.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# WebSocket support in esp_http_server (live view /ws).
CONFIG_HTTPD_WS_SUPPORT=y
# ESP-IDF v5.5.5 no longer calls the /ws handler for the handshake; live.c
# registers new clients from the post-handshake callback, which needs this.
# An existing esp32/sdkconfig overrides these defaults: delete it after
# pulling this change (live.c stops the build with #error otherwise).
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# Sockets: httpd (7 sessions + listen + control) + recording server (listen,
# client, one transient while it is being replaced). httpd requires
# max_open_sockets (7) <= LWIP_MAX_SOCKETS - 3.
CONFIG_LWIP_MAX_SOCKETS=16
